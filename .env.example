# Proveedor principal recomendado para CoderCup.
AI_PROVIDER=groq

# Crear en https://console.groq.com/keys y mantener SOLO en servidor.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Fallback local opcional.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_URL=http://127.0.0.1:11434

# Automatización de Google Calendar mediante Make.
# Nunca exponer estas variables al navegador (sin prefijo NEXT_PUBLIC_).
MAKE_CALENDAR_WEBHOOK_URL=
MAKE_CALENDAR_WEBHOOK_API_KEY=

# Segundo webhook de Make para deshacer/eliminar un evento de Google Calendar.
# Se configura después de validar el P0; usa la misma API key.
MAKE_CALENDAR_DELETE_WEBHOOK_URL=
