{
  "name": "QueHago - Deshacer evento de Google Calendar",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "¿QuéHago? - Deshacer"
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "google-calendar:deleteAnEvent",
      "version": 5,
      "parameters": {},
      "mapper": {
        "calendar": "primary",
        "event": "{{1.event_id}}"
      },
      "metadata": {
        "designer": {
          "x": 360,
          "y": 0,
          "name": "Google Calendar - Eliminar evento"
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ],
        "restore": {
          "expect": {
            "calendar": {
              "mode": "chose",
              "label": "Primary Calendar"
            }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "status": "200",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "body": "{\"ok\":true,\"event_id\":\"{{1.event_id}}\",\"source\":\"quehago\"}"
      },
      "metadata": {
        "designer": {
          "x": 720,
          "y": 0,
          "name": "Responder a ¿QuéHago?"
        },
        "restore": {
          "expect": {
            "headers": {
              "mode": "chose"
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}